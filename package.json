{
  "name": "opencode-custom-providers",
  "version": "0.1.0",
  "description": "OpenCode Desktop plugin that adds, edits and removes OpenAI-compatible providers from a GUI.",
  "license": "MIT",
  "author": "Sina Asemani",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
